{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ContosoDashboard;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "DocumentStorage": {
    "StoragePath": "AppData/uploads",
    "MaxFileSizeMb": 25,
    "AllowedExtensions": ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.png,.jpg,.jpeg",
    "OfflineMode": true,
    "QueueName": "document-scan-queue"
  }
}
